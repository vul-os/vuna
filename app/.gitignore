# App-local ignores. The repo root .gitignore already covers target/, dist/, node_modules/
# generically (unanchored patterns), so this only adds what's specific to this Tauri project.

# Auto-generated by `tauri-build` on every `cargo build` (capability/ACL JSON schemas for editor
# validation) — regenerated from tauri.conf.json + capabilities/*.json, never hand-edited.
src-tauri/gen/

# tsc project-reference incremental build info (kept out of node_modules root clutter already
# via tsconfig's tsBuildInfoFile path, but ignore defensively).
node_modules/.tmp/
