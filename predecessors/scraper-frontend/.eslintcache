rSpacing: '-0.06px'\n  },\n  h5: {\n    fontWeight: 500,\n    fontSize: 16,\n    letterSpacing: '-0.05px'\n  },\n  h6: {\n    fontWeight: 500,\n    fontSize: 14,\n    letterSpacing: '-0.05px'\n  },\n  overline: {\n    fontWeight: 500\n  }\n};\n","/home/imran/Documents/Personal/projects/scraper-frontend/src/layouts/DashboardLayout/index.js",["113","114"],"import React, {useEffect, useState} from 'react';\nimport { Outlet } from 'react-router-dom';\nimport { makeStyles } from '@material-ui/core';\nimport { useAuth0 } from '@auth0/auth0-react';\nimport DashboardIcon from '@material-ui/icons/Dashboard';\nimport NavBar from './NavBar';\nimport TopBar from './TopBar';\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    backgroundColor: theme.palette.background.dark,\n    display: 'flex',\n    height: '100%',\n    overflow: 'hidden',\n    width: '100%'\n  },\n  wrapper: {\n    display: 'flex',\n    flex: '1 1 auto',\n    overflow: 'hidden',\n    paddingTop: 64,\n    [theme.breakpoints.up('lg')]: {\n      paddingLeft: 256\n    }\n  },\n  contentContainer: {\n    display: 'flex',\n    flex: '1 1 auto',\n    overflow: 'hidden'\n  },\n  content: {\n    flex: '1 1 auto',\n    height: '100%',\n    overflow: 'auto'\n  }\n}));\n\n\nconst DashboardLayout = ( { dashboards }) => {\n  const classes = useStyles();\n  const [isMobileNavOpen, setMobileNavOpen] = useState(false);\n\n  const {\n    // user,\n    isAuthenticated,\n    loginWithRedirect,\n    isLoading\n  } = useAuth0();\n\n  if (isLoading) {\n    return <div>Loading ...</div>;\n  }\n\n  if (!isAuthenticated) {\n    loginWithRedirect().then();\n  }\n\n  return (\n    isAuthenticated && (\n      <div className={classes.root}>\n        <TopBar onMobileNavOpen={() => setMobileNavOpen(true)} />\n        <NavBar\n          onMobileClose={() => setMobileNavOpen(false)}\n          openMobile={isMobileNavOpen}\n          dashboards={dashboards}\n        />\n        <div className={classes.wrapper}>\n          <div className={classes.contentContainer}>\n            <div className={classes.content}>\n              <Outlet />\n            </div>\n          </div>\n        </div>\n      </div>\n    )\n  );\n};\n\nexport default DashboardLayout;\n","/home/imran/Documents/Personal/projects/scraper-frontend/src/views/settings/SettingsView/index.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/components/Page.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/icons/Google.js",[],["115","116","117","118","119","120"],"/home/imran/Documents/Personal/projects/scraper-frontend/src/icons/Facebook.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/layouts/DashboardLayout/TopBar.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/views/settings/SettingsView/Notifications.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/components/Logo.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/layouts/DashboardLayout/NavBar/index.js",["121","122","123","124"],"import React, { useEffect } from 'react';\nimport {Link as RouterLink, Route, useLocation} from 'react-router-dom';\nimport PropTypes from 'prop-types';\n\nimport Collapse from '@material-ui/core/Collapse';\nimport ExpandLess from '@material-ui/icons/ExpandLess';\nimport ExpandMore from '@material-ui/icons/ExpandMore';\nimport ListItem from '@material-ui/core/ListItem';\nimport ListItemIcon from '@material-ui/core/ListItemIcon';\nimport ListItemText from '@material-ui/core/ListItemText';\n\nimport {\n  Avatar,\n  Box,\n  Button,\n  Divider,\n  Drawer,\n  Hidden,\n  List,\n  Typography,\n  makeStyles,\n} from '@material-ui/core';\nimport {\n  BarChart as BarChartIcon,\n  Settings as SettingsIcon,\n  // ShoppingBag as ShoppingBagIcon,\n  // User as UserIcon,\n} from 'react-feather';\nimport { useAuth0 } from '@auth0/auth0-react';\nimport NavItem from './NavItem';\nimport DashboardIcon from \"@material-ui/icons/Dashboard\";\nimport DashboardView from \"../../../views/reports\";\nimport {makeTextURLFriendly} from \"../../../App\";\n\nconst items = [\n  {\n    href: '/app/settings',\n    icon: SettingsIcon,\n    title: 'Settings'\n  }\n];\n\nconst useStyles = makeStyles(() => ({\n  mobileDrawer: {\n    width: 256\n  },\n  desktopDrawer: {\n    width: 256,\n    top: 64,\n    height: 'calc(100% - 64px)'\n  },\n  avatar: {\n    cursor: 'pointer',\n    width: 64,\n    height: 64,\n    marginBottom: 15,\n    marginTop: 15\n  }\n}));\n\n\n// eslint-disable-next-line react/prop-types\nconst NavBar = ({ onMobileClose, openMobile, dashboards }) => {\n  const classes = useStyles();\n  const location = useLocation();\n  const [open, setOpen] = React.useState(true);\n  const { user } = useAuth0();\n\n  const handleClick = () => {\n    setOpen(!open);\n  };\n  useEffect(() => {\n    if (openMobile && onMobileClose) {\n      onMobileClose();\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [location.pathname]);\n\n  const content = (\n    <Box\n      height=\"100%\"\n      display=\"flex\"\n      flexDirection=\"column\"\n    >\n      <Box\n        alignItems=\"center\"\n        display=\"flex\"\n        flexDirection=\"column\"\n        p={2}\n      >\n        <Avatar\n          className={classes.avatar}\n          component={RouterLink}\n          src={user.picture}\n          to=\"/app/settings\"\n        />\n        <Typography\n          className={classes.name}\n          color=\"textPrimary\"\n          variant=\"h5\"\n        >\n          {user.name}\n        </Typography>\n        <Typography\n          color=\"textSecondary\"\n          variant=\"body2\"\n        >\n          {user.email}\n        </Typography>\n      </Box>\n      <Divider />\n      <Box p={2}>\n        <List>\n          {items.map((item) => (\n            <NavItem\n              href={item.href}\n              key={item.title}\n              title={item.title}\n              icon={item.icon}\n            />\n          ))}\n        </List>\n      </Box>\n      <Divider />\n      <Box p={2}>\n        <List>\n          <ListItem button onClick={handleClick}>\n            <ListItemIcon>\n              <BarChartIcon />\n            </ListItemIcon>\n            <ListItemText primary=\"Dashboards\" />\n            {open ? <ExpandLess /> : <ExpandMore />}\n          </ListItem>\n\n          <Collapse in={open} timeout=\"auto\" unmountOnExit>\n            <List component=\"div\" disablePadding>\n              {dashboards.map((item) => {\n                    return <NavItem\n                      key={item.title}\n                      title={item.title}\n                      icon={item.icon}\n                    />\n                  }\n                )\n              }\n            </List>\n          </Collapse>\n        </List>\n      </Box>\n      <Box flexGrow={1} />\n      <Box\n        p={2}\n        m={2}\n        bgcolor=\"background.dark\"\n      >\n        <Typography\n          align=\"center\"\n          gutterBottom\n          variant=\"h4\"\n        >\n          Need more?\n        </Typography>\n        <Typography\n          align=\"center\"\n          variant=\"body2\"\n        >\n          Upgrade for more insights!\n        </Typography>\n        <Box\n          display=\"flex\"\n          justifyContent=\"center\"\n          mt={2}\n        >\n          <Button\n            color=\"primary\"\n            component=\"a\"\n            href=\"https://react-material-kit.devias.io\"\n            variant=\"contained\"\n          >\n            UPGRADE\n          </Button>\n        </Box>\n      </Box>\n    </Box>\n  );\n\n  return (\n    <>\n      <Hidden lgUp>\n        <Drawer\n          anchor=\"left\"\n          classes={{ paper: classes.mobileDrawer }}\n          onClose={onMobileClose}\n          open={openMobile}\n          variant=\"temporary\"\n        >\n          {content}\n        </Drawer>\n      </Hidden>\n      <Hidden mdDown>\n        <Drawer\n          anchor=\"left\"\n          classes={{ paper: classes.desktopDrawer }}\n          open\n          variant=\"persistent\"\n        >\n          {content}\n        </Drawer>\n      </Hidden>\n    </>\n  );\n};\n\nNavBar.propTypes = {\n  onMobileClose: PropTypes.func,\n  openMobile: PropTypes.bool\n};\n\nNavBar.defaultProps = {\n  onMobileClose: () => {},\n  openMobile: false\n};\n\nexport default NavBar;\n","/home/imran/Documents/Personal/projects/scraper-frontend/src/utils/getInitials.js",[],["125","126","127","128","129","130"],"/home/imran/Documents/Personal/projects/scraper-frontend/src/layouts/DashboardLayout/NavBar/NavItem.js",[],["131","132"],"/home/imran/Documents/Personal/projects/scraper-frontend/src/utils/history.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/views/reports/index.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/layouts/MainLayout/index.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/layouts/MainLayout/TopBar.js",[],"/home/imran/Documents/Personal/projects/scraper-frontend/src/components/Loading/Loding.js",[],{"ruleId":"133","replacedBy":"134"},{"ruleId":"135","replacedBy":"136"},{"ruleId":"137","severity":1,"message":"138","line":6,"column":8,"nodeType":"139","messageId":"140","endLine":6,"endColumn":24},{"ruleId":"137","severity":1,"message":"141","line":58,"column":5,"nodeType":"139","messageId":"140","endLine":58,"endColumn":27},{"ruleId":"142","severity":1,"message":"143","line":1,"column":1,"nodeType":"144","endLine":27,"endColumn":3},{"ruleId":"142","severity":1,"message":"145","line":1,"column":1,"nodeType":"144","endLine":35,"endColumn":3},{"ruleId":"137","severity":1,"message":"146","line":1,"column":16,"nodeType":"139","messageId":"140","endLine":1,"endColumn":25},{"ruleId":"137","severity":1,"message":"147","line":5,"column":8,"nodeType":"139","messageId":"140","endLine":5,"endColumn":21},{"ruleId":"148","replacedBy":"149"},{"ruleId":"150","replacedBy":"151"},{"ruleId":"15